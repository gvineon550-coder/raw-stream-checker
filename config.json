{
  "concurrency": 80,
  "http_timeout": 5,
  "ffprobe_timeout": 8,
  "ffprobe_threads": 50,
  "ffprobe_probesize": 32768,
  "ffprobe_analyzeduration": 1000000,
  "warm_cache_ttl_hours": 6,
  "dead_cache_min_fails": 3,
  "dead_cache_ttl_days": 30,
  "host_block_after_fails": 10,
  "output_m3u": "playlist.m3u",
  "ua_weights": {
    "Wink": 30, "HlsWinkPlayer": 25, "TiviMate": 12,
    "AndroidTV": 8, "VLC": 8, "SmartTV": 6, "Kodi": 5,
    "OTT": 5, "ExoPlayer": 4, "Lavf": 3, "okhttp": 3,
    "Chrome_Win": 3, "Safari_Mac": 2, "Firefox": 2, "MXPlayer": 2
  },
  "epg_url": "https://iptvx.one/epg/epg_lite.xml.gz",
  "epg_url_fallback": "https://epg.one/epg.xml.gz",
  "epg_ttl_hours": 168,
  "check_black_screen": true,
  "check_audio": true,
  "check_static_image": true,
  "quality_check_sample_sec": 5,
  "quality_check_timeout_sec": 20,
  "quality_audio_min_db": -70,
  "quality_black_min_duration": 2.0,
  "quality_static_min_duration": 3.0,
  "quality_check_cache_days": 7,
  "problem_threshold": 5,
  "problem_block_ttl_days": 30
}
